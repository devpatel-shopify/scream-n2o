        "custom_liquid": "<script>\n(function(){\n  const selector = '[data-forms-id=\"forms-root-785848\"]';\n  const offset = 0;             // increase if you have sticky header (px)\n  const pollInterval = 120;     // retry interval (ms)\n  const maxPolls = 80;          // total retries before using MutationObserver\n\n  let polls = 0;\n\n  function scrollToTarget(el){\n    const elementTop = el.getBoundingClientRect().top + window.pageYOffset;\n    const elementHeight = el.offsetHeight;\n    const viewportHeight = window.innerHeight;\n\n    // Center element in viewport\n    const top = elementTop - (viewportHeight / 2) + (elementHeight / 2) - offset;\n\n    window.scrollTo({ top, behavior: 'smooth' });\n  }\n\n  function tryScroll(){\n    const el = document.querySelector(selector);\n    if (el) {\n      scrollToTarget(el);\n      return true;\n    }\n    return false;\n  }\n\n  function startPolling() {\n    if (tryScroll()) return;\n\n    const poll = setInterval(() => {\n      polls++;\n      if (tryScroll()) {\n        clearInterval(poll);\n        return;\n      }\n      if (polls >= maxPolls) {\n        clearInterval(poll);\n        // Fallback: observe DOM for later insertion\n        const mo = new MutationObserver((mutations, observer) => {\n          const el = document.querySelector(selector);\n          if (el) {\n            scrollToTarget(el);\n            observer.disconnect();\n          }\n        });\n        mo.observe(document.documentElement, { childList: true, subtree: true });\n      }\n    }, pollInterval);\n  }\n\n  // Start after DOM ready; also attempt again on full load\n  if (document.readyState === 'complete' || document.readyState === 'interactive') {\n    setTimeout(startPolling, 50);\n  } else {\n    document.addEventListener('DOMContentLoaded', () => setTimeout(startPolling, 50));\n    window.addEventListener('load', () => setTimeout(startPolling, 50));\n  }\n})();\n</script>",
