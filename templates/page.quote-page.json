    "custom_liquid_BHVVKU": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<script>\nconst selector = '[data-forms-id=\"forms-root-785848\"]';\nconst offset = 0;\n\n// URL param check\nconst urlParams = new URLSearchParams(window.location.search);\nconst scrollParam = urlParams.get('scroll');\n\n// Determine whether to auto-scroll on page load\nconst shouldAutoScroll = scrollParam === \"true\";\n\n// Remove 'scroll' param from URL immediately without reloading\nif (scrollParam !== null) {\n  urlParams.delete('scroll');\n  const newUrl =\n    window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '');\n  history.replaceState(null, '', newUrl);\n}\n\nfunction scrollCenter(el) {\n  const rect = el.getBoundingClientRect();\n  const elementTop = rect.top + window.pageYOffset;\n  const viewportHeight = window.innerHeight;\n  const elementHeight = rect.height;\n\n  const top =\n    elementTop - viewportHeight / 2 + elementHeight / 2 - offset;\n\n  window.scrollTo({ top, behavior: \"smooth\" });\n}\n\n// Wait until form loads\nfunction waitForForm(callback) {\n  const check = setInterval(() => {\n    const el = document.querySelector(selector);\n    if (el && el.offsetHeight > 30) {\n      clearInterval(check);\n      callback(el);\n    }\n  }, 50);\n}\n\n// ✅ Page load auto scroll (only if scroll=true)\nwindow.addEventListener(\"load\", function () {\n  if (shouldAutoScroll) {\n    waitForForm(scrollCenter);\n  }\n\n  // ✅ Href always blank\n  document.querySelectorAll(\".scroll-forrmsection\").forEach(el => {\n    el.setAttribute(\"href\", \"\");\n  });\n});\n\n// ✅ Click handler → ONLY scroll on button click\ndocument.addEventListener(\"click\", function (e) {\n  const btn = e.target.closest(\".scroll-forrmsection\");\n  if (!btn) return;\n\n  e.preventDefault(); // stop default anchor behavior\n  e.stopPropagation();\n\n  waitForForm(scrollCenter);\n});\n</script>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
