{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-icon-features-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-icon-features-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-icon-features-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-icon-features-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 15px;
    text-transform: {{ block.settings.heading_transform }};
    font-weight: 700;
  }

  .ai-icon-features-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    opacity: 0.85;
  }

  .ai-icon-features-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-icon-feature-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
    position: relative;
    overflow: hidden;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-icon-feature-card-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
    border-color: {{ block.settings.icon_background }};
  }

  .ai-icon-feature-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto 25px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-icon-feature-icon-bg-{{ ai_gen_id }} {
    position: absolute;
    width: 100%;
    height: 100%;
    background: {{ block.settings.icon_background }};
    border-radius: {{ block.settings.icon_shape }};
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-icon-feature-card-{{ ai_gen_id }}:hover .ai-icon-feature-icon-bg-{{ ai_gen_id }} {
    transform: rotate(45deg) scale(1.1);
  }

  .ai-icon-feature-icon-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    width: {{ block.settings.icon_size | times: 0.6 }}px;
    height: {{ block.settings.icon_size | times: 0.6 }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-icon-feature-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-icon-feature-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-icon-feature-icon-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    opacity: 0.4;
  }

  .ai-icon-feature-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
  }

  .ai-icon-feature-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
    font-weight: 700;
    text-transform: {{ block.settings.card_title_transform }};
  }

  .ai-icon-feature-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
    opacity: 0.9;
  }

  .ai-icon-feature-number-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.card_padding }}px;
    right: {{ block.settings.card_padding }}px;
    font-size: {{ block.settings.card_title_size | times: 2 }}px;
    font-weight: 900;
    color: {{ block.settings.card_border_color }};
    opacity: 0.15;
    line-height: 1;
    z-index: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-icon-features-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.8 }}px;
    }

    .ai-icon-features-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-icon-features-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-icon-features-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-icon-features-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }

    .ai-icon-feature-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-icon-feature-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.48 }}px;
      height: {{ block.settings.icon_size | times: 0.48 }}px;
    }
  }
{% endstyle %}

<icon-features-{{ ai_gen_id }} class="ai-icon-features-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-icon-features-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-icon-features-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-icon-features-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-icon-features-subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-icon-features-grid-{{ ai_gen_id }}">
      <div class="ai-icon-feature-card-{{ ai_gen_id }}">
        {% if block.settings.show_numbers %}
          <div class="ai-icon-feature-number-{{ ai_gen_id }}">01</div>
        {% endif %}
        <div class="ai-icon-feature-icon-wrapper-{{ ai_gen_id }}">
          <div class="ai-icon-feature-icon-bg-{{ ai_gen_id }}"></div>
          <div class="ai-icon-feature-icon-{{ ai_gen_id }}">
            {% if block.settings.icon_1 %}
              <img
                src="{{ block.settings.icon_1 | image_url: width: 200 }}"
                alt="{{ block.settings.icon_1.alt | escape }}"
                loading="lazy"
                width="200"
                height="200"
              >
            {% else %}
              <div class="ai-icon-feature-icon-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
        <div class="ai-icon-feature-content-{{ ai_gen_id }}">
          {% if block.settings.title_1 != blank %}
            <h3 class="ai-icon-feature-title-{{ ai_gen_id }}">{{ block.settings.title_1 }}</h3>
          {% endif %}
          {% if block.settings.text_1 != blank %}
            <p class="ai-icon-feature-text-{{ ai_gen_id }}">{{ block.settings.text_1 }}</p>
          {% endif %}
        </div>
      </div>

      <div class="ai-icon-feature-card-{{ ai_gen_id }}">
        {% if block.settings.show_numbers %}
          <div class="ai-icon-feature-number-{{ ai_gen_id }}">02</div>
        {% endif %}
        <div class="ai-icon-feature-icon-wrapper-{{ ai_gen_id }}">
          <div class="ai-icon-feature-icon-bg-{{ ai_gen_id }}"></div>
          <div class="ai-icon-feature-icon-{{ ai_gen_id }}">
            {% if block.settings.icon_2 %}
              <img
                src="{{ block.settings.icon_2 | image_url: width: 200 }}"
                alt="{{ block.settings.icon_2.alt | escape }}"
                loading="lazy"
                width="200"
                height="200"
              >
            {% else %}
              <div class="ai-icon-feature-icon-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
        <div class="ai-icon-feature-content-{{ ai_gen_id }}">
          {% if block.settings.title_2 != blank %}
            <h3 class="ai-icon-feature-title-{{ ai_gen_id }}">{{ block.settings.title_2 }}</h3>
          {% endif %}
          {% if block.settings.text_2 != blank %}
            <p class="ai-icon-feature-text-{{ ai_gen_id }}">{{ block.settings.text_2 }}</p>
          {% endif %}
        </div>
      </div>

      <div class="ai-icon-feature-card-{{ ai_gen_id }}">
        {% if block.settings.show_numbers %}
          <div class="ai-icon-feature-number-{{ ai_gen_id }}">03</div>
        {% endif %}
        <div class="ai-icon-feature-icon-wrapper-{{ ai_gen_id }}">
          <div class="ai-icon-feature-icon-bg-{{ ai_gen_id }}"></div>
          <div class="ai-icon-feature-icon-{{ ai_gen_id }}">
            {% if block.settings.icon_3 %}
              <img
                src="{{ block.settings.icon_3 | image_url: width: 200 }}"
                alt="{{ block.settings.icon_3.alt | escape }}"
                loading="lazy"
                width="200"
                height="200"
              >
            {% else %}
              <div class="ai-icon-feature-icon-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
        <div class="ai-icon-feature-content-{{ ai_gen_id }}">
          {% if block.settings.title_3 != blank %}
            <h3 class="ai-icon-feature-title-{{ ai_gen_id }}">{{ block.settings.title_3 }}</h3>
          {% endif %}
          {% if block.settings.text_3 != blank %}
            <p class="ai-icon-feature-text-{{ ai_gen_id }}">{{ block.settings.text_3 }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</icon-features-{{ ai_gen_id }}>

<script>
  (function() {
    class IconFeatures{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const cards = this.querySelectorAll('.ai-icon-feature-card-{{ ai_gen_id }}');
        cards.forEach((card, index) => {
          card.setAttribute('role', 'article');
          card.setAttribute('aria-label', `Feature ${index + 1}`);
        });
      }
    }

    customElements.define('icon-features-{{ ai_gen_id }}', IconFeatures{{ ai_gen_id }});
  })();
</script>

