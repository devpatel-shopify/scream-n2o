{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-who-we-serve-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-who-we-serve-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-who-we-serve-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-who-we-serve-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    text-transform: {{ block.settings.title_transform }};
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
    font-weight: 700;
  }

  .ai-who-we-serve-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  .ai-who-we-serve-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-top: {{ block.settings.grid_top_spacing }}px;
  }

  .ai-who-we-serve-card-{{ ai_gen_id }} {
    position: relative;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .ai-who-we-serve-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.hover_shadow_y }}px {{ block.settings.hover_shadow_blur }}px {{ block.settings.card_shadow_color }};
    border-color: {{ block.settings.card_hover_border_color }};
  }

  .ai-who-we-serve-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.image_height }}px;
    overflow: hidden;
    background: {{ block.settings.image_placeholder_bg }};
  }

  .ai-who-we-serve-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-who-we-serve-card-{{ ai_gen_id }}:hover .ai-who-we-serve-card-image-{{ ai_gen_id }} {
    transform: scale({{ block.settings.image_scale }});
  }

  .ai-who-we-serve-card-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 0%, {{ block.settings.overlay_color }} 100%);
    opacity: {{ block.settings.overlay_opacity }};
    transition: opacity 0.4s ease;
  }

  .ai-who-we-serve-card-{{ ai_gen_id }}:hover .ai-who-we-serve-card-overlay-{{ ai_gen_id }} {
    opacity: {{ block.settings.overlay_hover_opacity }};
  }

  .ai-who-we-serve-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .ai-who-we-serve-card-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_size }}px;
    color: {{ block.settings.category_color }};
    font-weight: 700;
    margin: 0 0 12px;
    text-transform: {{ block.settings.category_transform }};
    letter-spacing: 1.5px;
    display: inline-block;
  }

  .ai-who-we-serve-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 16px;
    line-height: 1.2;
    font-weight: 700;
  }

  .ai-who-we-serve-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0 0 24px;
    line-height: 1.6;
    flex-grow: 1;
  }

  .ai-who-we-serve-card-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 700;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    text-transform: {{ block.settings.button_text_transform }};
    letter-spacing: 0.5px;
    align-self: flex-start;
    gap: 8px;
  }

  .ai-who-we-serve-card-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateX(4px);
  }

  .ai-who-we-serve-card-button-{{ ai_gen_id }}::after {
    content: '→';
    font-size: 18px;
    transition: transform 0.3s ease;
    position: relative;
    top: -2px;
  }

  .ai-who-we-serve-card-button-{{ ai_gen_id }}:hover::after {
    transform: translateX(4px);
  }

  .ai-who-we-serve-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ block.settings.image_placeholder_bg }};
  }

  .ai-who-we-serve-image-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-who-we-serve-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.card_gap | times: 0.75 }}px;
    }

    .ai-who-we-serve-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-who-we-serve-card-image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.image_height | times: 0.85 }}px;
    }

    .ai-who-we-serve-card-content-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-who-we-serve-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.card_gap | times: 0.6 }}px;
    }

    .ai-who-we-serve-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 16px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-who-we-serve-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.5 }}px;
    }

    .ai-who-we-serve-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-who-we-serve-card-image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.image_height | times: 0.7 }}px;
    }

    .ai-who-we-serve-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_title_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<who-we-serve-{{ ai_gen_id }} class="ai-who-we-serve-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-who-we-serve-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank or block.settings.section_subtitle != blank %}
      <div class="ai-who-we-serve-header-{{ ai_gen_id }}">
        {% if block.settings.section_title != blank %}
          <h2 class="ai-who-we-serve-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
        {% endif %}
        {% if block.settings.section_subtitle != blank %}
          <p class="ai-who-we-serve-subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-who-we-serve-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign card_enabled_key = 'card_' | append: i | append: '_enabled'
          assign card_image_key = 'card_' | append: i | append: '_image'
          assign card_category_key = 'card_' | append: i | append: '_category'
          assign card_title_key = 'card_' | append: i | append: '_title'
          assign card_description_key = 'card_' | append: i | append: '_description'
          assign card_button_text_key = 'card_' | append: i | append: '_button_text'
          assign card_button_link_key = 'card_' | append: i | append: '_button_link'

          assign card_enabled = block.settings[card_enabled_key]
          assign card_image = block.settings[card_image_key]
          assign card_category = block.settings[card_category_key]
          assign card_title = block.settings[card_title_key]
          assign card_description = block.settings[card_description_key]
          assign card_button_text = block.settings[card_button_text_key]
          assign card_button_link = block.settings[card_button_link_key]
        %}

        {% if card_enabled %}
          <div class="ai-who-we-serve-card-{{ ai_gen_id }}">
            <div class="ai-who-we-serve-card-image-wrapper-{{ ai_gen_id }}">
              {% if card_image %}
                <img
                  src="{{ card_image | image_url: width: 800 }}"
                  alt="{{ card_image.alt | escape }}"
                  class="ai-who-we-serve-card-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="800"
                  height="{{ block.settings.image_height }}"
                >
              {% else %}
                <div class="ai-who-we-serve-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
              <div class="ai-who-we-serve-card-overlay-{{ ai_gen_id }}"></div>
            </div>

            <div class="ai-who-we-serve-card-content-{{ ai_gen_id }}">
              {% if card_category != blank %}
                <div class="ai-who-we-serve-card-category-{{ ai_gen_id }}">{{ card_category }}</div>
              {% endif %}

              {% if card_title != blank %}
                <h3 class="ai-who-we-serve-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
              {% endif %}

              {% if card_description != blank %}
                <p class="ai-who-we-serve-card-description-{{ ai_gen_id }}">{{ card_description }}</p>
              {% endif %}

              {% if card_button_text != blank %}
                <a
                  href="{{ card_button_link | default: '#' }}"
                  class="ai-who-we-serve-card-button-{{ ai_gen_id }}"
                >
                  {{ card_button_text }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</who-we-serve-{{ ai_gen_id }}>

<script>
  (function() {
    class WhoWeServe{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-who-we-serve-card-{{ ai_gen_id }}');
        this.observeCards();
      }

      observeCards() {
        const options = {
          threshold: 0.15,
          rootMargin: '0px 0px -80px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry, index) => {
            if (entry.isIntersecting) {
              setTimeout(() => {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
              }, index * 120);
              observer.unobserve(entry.target);
            }
          });
        }, options);

        this.cards.forEach((card) => {
          card.style.opacity = '0';
          card.style.transform = 'translateY(40px)';
          card.style.transition = 'opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1), transform 0.7s cubic-bezier(0.4, 0, 0.2, 1)';
          observer.observe(card);
        });
      }
    }

    customElements.define('who-we-serve-{{ ai_gen_id }}', WhoWeServe{{ ai_gen_id }});
  })();
</script>

