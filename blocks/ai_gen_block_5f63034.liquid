<script>
  (function() {
    class FeatureSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-feature-card-{{ ai_gen_id }}');
        this.setupInteractions();
      }

      setupInteractions() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          return;
        }

        this.cards.forEach((card) => {
          const image = card.querySelector('.ai-feature-image-{{ ai_gen_id }}');
          if (!image) return;

          card.addEventListener('mouseenter', () => {
            image.style.transform = 'scale(1.08)';
          });

          card.addEventListener('mouseleave', () => {
            image.style.transform = 'scale(1)';
          });
        });
      }
    }

    customElements.define('feature-section-{{ ai_gen_id }}', FeatureSection{{ ai_gen_id }});
  })();
</script>

