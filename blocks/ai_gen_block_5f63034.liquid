{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
    background: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
  }

  .ai-feature-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-feature-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
    background: {{ block.settings.divider_color }};
  }

  .ai-feature-card-{{ ai_gen_id }} {
    position: relative;
    background: {{ block.settings.card_background }};
    overflow: hidden;
    min-height: 350px;
    display: flex;
    align-items: center;
    transition: transform 0.4s ease;
  }

  .ai-feature-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-feature-image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-feature-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease, opacity 0.4s ease;
  }

  .ai-feature-card-{{ ai_gen_id }}:hover .ai-feature-image-{{ ai_gen_id }} {
    transform: scale(1.08);
    opacity: 0.85;
  }

  .ai-feature-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    transition: opacity 0.4s ease;
  }

  .ai-feature-card-1-{{ ai_gen_id }} .ai-feature-overlay-{{ ai_gen_id }} {
    background: linear-gradient(135deg, {{ block.settings.card1_overlay_start }} 0%, {{ block.settings.card1_overlay_end }} 100%);
  }

  .ai-feature-card-2-{{ ai_gen_id }} .ai-feature-overlay-{{ ai_gen_id }} {
    background: linear-gradient(135deg, {{ block.settings.card2_overlay_start }} 0%, {{ block.settings.card2_overlay_end }} 100%);
  }

  .ai-feature-card-3-{{ ai_gen_id }} .ai-feature-overlay-{{ ai_gen_id }} {
    background: linear-gradient(135deg, {{ block.settings.card3_overlay_start }} 0%, {{ block.settings.card3_overlay_end }} 100%);
  }

  .ai-feature-card-{{ ai_gen_id }}:hover .ai-feature-overlay-{{ ai_gen_id }} {
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 | times: 0.8 }};
  }

  .ai-feature-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    padding: 50px 40px;
    width: 100%;
  }

  .ai-feature-number-{{ ai_gen_id }} {
    font-size: 80px;
    font-weight: 700;
    color: {{ block.settings.number_color }};
    opacity: 0.15;
    line-height: 1;
    margin: 0 0 -20px;
    font-family: {{ block.settings.type_heading_font.family }}, {{ block.settings.type_heading_font.fallback_families }};
  }

  .ai-feature-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    font-weight: 600;
    color: {{ block.settings.eyebrow_color }};
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 12px;
    display: inline-block;
    position: relative;
  }

  .ai-feature-eyebrow-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 40px;
    height: 2px;
    background: {{ block.settings.accent_color }};
  }

  .ai-feature-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-feature-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.7;
    color: {{ block.settings.description_color }};
    margin: 0 0 28px;
  }

  .ai-feature-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    transition: gap 0.3s ease, color 0.3s ease;
    position: relative;
  }

  .ai-feature-link-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: {{ block.settings.link_hover_color }};
    transition: width 0.3s ease;
  }

  .ai-feature-link-{{ ai_gen_id }}:hover {
    gap: 16px;
    color: {{ block.settings.link_hover_color }};
  }

  .ai-feature-link-{{ ai_gen_id }}:hover::before {
    width: calc(100% - 26px);
  }

  .ai-feature-link-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .ai-feature-link-{{ ai_gen_id }}:hover .ai-feature-link-icon-{{ ai_gen_id }} {
    transform: translateX(4px);
  }

  .ai-feature-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #f0f0f0 0%, #e0e0e0 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-placeholder-{{ ai_gen_id }} svg {
    width: 100px;
    height: 100px;
    opacity: 0.2;
  }

  .ai-feature-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 30px;
    right: 30px;
    background: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    z-index: 4;
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .ai-feature-card-{{ ai_gen_id }}:hover .ai-feature-badge-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
  }

  @media screen and (min-width: 750px) {
    .ai-feature-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-feature-card-1-{{ ai_gen_id }} {
      grid-column: 1 / 2;
      grid-row: 1 / 3;
      min-height: 600px;
    }

    .ai-feature-card-2-{{ ai_gen_id }} {
      grid-column: 2 / 3;
      grid-row: 1 / 2;
      min-height: 300px;
    }

    .ai-feature-card-3-{{ ai_gen_id }} {
      grid-column: 2 / 3;
      grid-row: 2 / 3;
      min-height: 300px;
    }

    .ai-feature-card-1-{{ ai_gen_id }} .ai-feature-content-{{ ai_gen_id }} {
      max-width: 500px;
      padding: 80px 60px;
    }
  }

  @media screen and (min-width: 990px) {
    .ai-feature-card-1-{{ ai_gen_id }} {
      min-height: 700px;
    }

    .ai-feature-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-feature-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.75 }}px;
    }

    .ai-feature-number-{{ ai_gen_id }} {
      font-size: 60px;
    }

    .ai-feature-content-{{ ai_gen_id }} {
      padding: 40px 30px;
    }

    .ai-feature-badge-{{ ai_gen_id }} {
      top: 20px;
      right: 20px;
    }
  }
{% endstyle %}

